<%- include('partials/header') %>

<div class="container my-5 animate-fade-in">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-3 mb-md-0 text-theme-heading">My Tasks</h1>
    <a href="/tasks/new" class="btn btn-primary shadow-sm">
      <span aria-hidden="true">+</span> Add New Task
    </a>
  </div>

  <!-- Summary Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card h-100 text-center border-0 shadow-sm p-3">
        <h5 class="card-title text-theme-secondary small text-uppercase fw-bold mb-2">Total Tasks</h5>
        <p class="display-6 fw-bold text-primary mb-0" id="summary-total">0</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100 text-center border-0 shadow-sm p-3">
        <h5 class="card-title text-theme-secondary small text-uppercase fw-bold mb-2">High Priority</h5>
        <p class="display-6 fw-bold text-danger mb-0" id="summary-high">0</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100 text-center border-0 shadow-sm p-3">
        <h5 class="card-title text-theme-secondary small text-uppercase fw-bold mb-2">Pending</h5>
        <p class="display-6 fw-bold text-warning mb-0" id="summary-pending">0</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100 text-center border-0 shadow-sm p-3">
        <h5 class="card-title text-theme-secondary small text-uppercase fw-bold mb-2">Completed</h5>
        <p class="display-6 fw-bold text-success mb-0" id="summary-completed">0</p>
      </div>
    </div>
  </div>

  <!-- Controls Container (Hidden initially until tasks load) -->
  <div id="controlsContainer" class="card border-0 shadow-sm p-3 mb-4 section-accent d-none">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-transparent text-theme-secondary border-end-0"><span aria-hidden="true">🔍</span></span>
          <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Search tasks by title, subject, student...">
        </div>
      </div>
      <div class="col-12 col-md-4">
        <select id="sortSelect" class="form-select text-theme-secondary">
          <option value="default">Sort: Default (Newest First)</option>
          <option value="oldest">Oldest First</option>
          <option value="deadlineAsc">Deadline: Nearest First</option>
          <option value="deadlineDesc">Deadline: Farthest First</option>
          <option value="priorityDesc">Priority: High to Low</option>
          <option value="titleAsc">Title: A to Z</option>
        </select>
      </div>
      <div class="col-12 col-md-3 text-md-end">
        <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary w-100">Reset Filters</button>
      </div>
    </div>

    <!-- Filter Buttons -->
    <div class="d-flex flex-wrap gap-2 mt-3" id="filterButtons">
      <button type="button" class="btn btn-sm btn-primary filter-btn task-filter-btn active" data-filter="all">All Tasks</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="high">High Priority</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="medium">Medium Priority</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="low">Low Priority</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="due-today">Due Today</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="upcoming">Upcoming</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="completed">Completed</button>
      <button type="button" class="btn btn-sm btn-outline-primary filter-btn task-filter-btn" data-filter="pending">Pending</button>
    </div>
    
    <div class="mt-2 text-theme-secondary small">
      Showing <span id="visibleCount" class="fw-bold">0</span> of <span id="totalCount">0</span> tasks
    </div>
  </div>

  <!-- Loading State -->
  <div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading tasks...</span>
    </div>
    <p class="mt-3 text-theme-secondary">Fetching tasks...</p>
  </div>

  <!-- Error State -->
  <div id="errorState" class="text-center py-5 d-none">
    <span class="display-1 text-danger opacity-75 d-block mb-3">⚠️</span>
    <h2 class="h4 fw-bold text-theme-heading">Failed to load tasks</h2>
    <p class="text-theme-secondary mb-4" id="errorMessage">Please check your connection and try again.</p>
    <button type="button" id="retryLoadBtn" class="btn btn-primary px-4 py-2">Retry</button>
  </div>

  <!-- Global Empty State (Hidden initially) -->
  <div class="col-12 w-100 d-none" id="globalEmptyState">
    <div class="card border-0 shadow-sm text-center py-5 px-3">
      <div class="card-body">
        <span class="display-1 text-muted opacity-50 mb-3 d-block">📋</span>
        <h2 class="h4 fw-bold text-theme-heading">No Tasks Yet</h2>
        <p class="text-theme-secondary mb-4">You haven't added any tasks. Start by creating your first study task!</p>
        <a href="/tasks/new" class="btn btn-primary px-4 py-2">Add Your First Task</a>
      </div>
    </div>
  </div>

  <!-- Task Cards Grid -->
  <div id="tasksContainer" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <!-- Tasks will be injected here via JavaScript -->
  </div>

  <!-- Empty State for Filters/Search (Hidden by default) -->
  <div id="filterEmptyState" class="col-12 w-100 d-none">
    <div class="card border-0 shadow-sm text-center py-5 px-3 section-accent">
      <div class="card-body">
        <span class="display-1 text-muted opacity-50 mb-3 d-block">🔍</span>
        <h2 class="h4 fw-bold text-theme-heading">No Matching Tasks</h2>
        <p class="text-theme-secondary mb-4">We couldn't find any tasks matching your current search or filters.</p>
        <button type="button" id="emptyStateResetBtn" class="btn btn-primary px-4 py-2">Clear Filters</button>
      </div>
    </div>
  </div>

</div>

<!-- Task Details Modal -->
<div class="modal fade" id="taskDetailsModal" tabindex="-1" aria-labelledby="taskDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow" style="background-color: var(--bg-card);">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold h4 text-theme-heading" id="taskDetailsModalLabel">Task Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-3 pb-4">
        <div class="row g-3">
          <div class="col-md-8">
            <h6 class="fw-bold text-theme-secondary mb-1">Title</h6>
            <p class="text-theme-heading fs-5" id="modal-title"></p>
          </div>
          <div class="col-md-4">
            <h6 class="fw-bold text-theme-secondary mb-1">Status</h6>
            <span id="modal-status" class="status-badge"></span>
          </div>
          
          <div class="col-md-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Student</h6>
            <p class="text-theme-heading mb-0" id="modal-student"></p>
            <p class="text-theme-secondary small" id="modal-email"></p>
          </div>
          <div class="col-md-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Subject</h6>
            <p class="text-theme-heading" id="modal-subject"></p>
          </div>
          
          <div class="col-12">
            <h6 class="fw-bold text-theme-secondary mb-1">Description</h6>
            <div class="p-3 rounded" style="background-color: var(--bg-primary);">
              <p class="text-theme-heading mb-0 text-break" style="white-space: pre-wrap;" id="modal-description"></p>
            </div>
          </div>
          
          <div class="col-md-3 col-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Deadline</h6>
            <p class="text-theme-heading" id="modal-deadline"></p>
          </div>
          <div class="col-md-3 col-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Priority</h6>
            <p class="text-theme-heading" id="modal-priority"></p>
          </div>
          <div class="col-md-3 col-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Category</h6>
            <p class="text-theme-heading" id="modal-category"></p>
          </div>
          <div class="col-md-3 col-6">
            <h6 class="fw-bold text-theme-secondary mb-1">Est. Hours</h6>
            <p class="text-theme-heading" id="modal-hours"></p>
          </div>
        </div>
      </div>
      <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Task Modal -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-labelledby="editTaskModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow" style="background-color: var(--bg-card);">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold h4 text-theme-heading" id="editTaskModalLabel">Edit Task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editTaskForm" novalidate>
        <div class="modal-body pt-3 pb-4">
          <input type="hidden" id="editTaskId">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Student Name</label>
              <input type="text" id="editStudentName" class="form-control" required>
              <div class="invalid-feedback" id="editStudentNameError"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Email</label>
              <input type="email" id="editEmail" class="form-control" required>
              <div class="invalid-feedback" id="editEmailError"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Task Title</label>
              <input type="text" id="editTaskTitle" class="form-control" required>
              <div class="invalid-feedback" id="editTaskTitleError"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Subject</label>
              <input type="text" id="editSubject" class="form-control" required>
              <div class="invalid-feedback" id="editSubjectError"></div>
            </div>
            <div class="col-12">
              <label class="form-label fw-bold">Description</label>
              <textarea id="editDescription" class="form-control" rows="3" required></textarea>
              <div class="invalid-feedback" id="editDescriptionError"></div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">Deadline</label>
              <input type="date" id="editDeadline" class="form-control" required>
              <div class="invalid-feedback" id="editDeadlineError"></div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">Priority</label>
              <select id="editPriority" class="form-select" required>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
              </select>
              <div class="invalid-feedback" id="editPriorityError"></div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">Category</label>
              <select id="editCategory" class="form-select" required>
                <option value="Assignment">Assignment</option>
                <option value="Exam Preparation">Exam Preparation</option>
                <option value="Project">Project</option>
                <option value="Revision">Revision</option>
                <option value="Other">Other</option>
              </select>
              <div class="invalid-feedback" id="editCategoryError"></div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">Hours</label>
              <input type="number" id="editEstimatedHours" class="form-control" required>
              <div class="invalid-feedback" id="editEstimatedHoursError"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveEditBtn">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteTaskModal" tabindex="-1" aria-labelledby="deleteTaskModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="background-color: var(--bg-card);">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold h4 text-danger" id="deleteTaskModalLabel">Delete Task?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-3 pb-4">
        <p class="text-theme-secondary mb-2">Are you sure you want to delete the following task?</p>
        <p class="fw-bold text-theme-heading fs-5 mb-0" id="deleteModalTaskTitle"></p>
        <p class="small text-danger mt-3 mb-0">This action cannot be undone.</p>
        <input type="hidden" id="deleteTaskId">
      </div>
      <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Toast Container for Notifications -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
  <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body fw-bold" id="toastMessage">
        Action successful!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<!-- Load Task 4 interactive scripts -->
<script src="/js/tasks.js" defer></script>

<%- include('partials/footer') %>
