<%- include('partials/header') %>

<div class="hero text-center mb-5">
  <div class="container hero-content animate-fade-in">
    <h1 class="display-4 fw-bold mb-3">Master Your Studies with StudyFlow</h1>
    <p class="lead mb-4">A simple, effective student productivity tool to organize assignments, track deadlines, and manage your study time efficiently.</p>
    <div class="d-flex justify-content-center gap-3">
      <a href="/tasks/new" class="btn btn-light btn-lg text-primary fw-bold">Add Your First Task</a>
      <a href="/tasks" class="btn btn-outline-light btn-lg">View All Tasks</a>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="text-center mb-5 animate-fade-in">
    <h2 class="fw-bold">Why Choose StudyFlow?</h2>
    <p class="text-muted-custom">Designed specifically for students to enhance productivity.</p>
  </div>
  
  <div class="row g-4 features-grid">
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 card-hover text-center p-4">
        <span class="display-4 mb-3">📅</span>
        <h3 class="h5 fw-bold text-primary">Manage Assignments</h3>
        <p class="text-muted-custom small">Keep all your homework, projects, and reading assignments in one organized place.</p>
      </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 card-hover text-center p-4">
        <span class="display-4 mb-3">⏰</span>
        <h3 class="h5 fw-bold text-primary">Track Deadlines</h3>
        <p class="text-muted-custom small">Never miss a due date again. See exactly what is due and when.</p>
      </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 card-hover text-center p-4">
        <span class="display-4 mb-3">📚</span>
        <h3 class="h5 fw-bold text-primary">Organize Subjects</h3>
        <p class="text-muted-custom small">Categorize your tasks by subject so you can focus on one class at a time.</p>
      </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 card-hover text-center p-4">
        <span class="display-4 mb-3">⭐</span>
        <h3 class="h5 fw-bold text-primary">Set Priorities</h3>
        <p class="text-muted-custom small">Identify high-priority tasks and focus your energy where it matters most.</p>
      </div>
    </div>
  </div>
</div>

<div class="bg-light py-5 mb-5" style="background-color: var(--secondary-color) !important;">
  <div class="container">
    <div class="text-center mb-5 animate-fade-in">
      <h2 class="fw-bold">How It Works</h2>
      <p class="text-muted-custom">Three simple steps to better productivity.</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4 text-center animate-fade-in" style="animation-delay: 0.1s;">
        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 80px; height: 80px; font-size: 2rem; color: var(--primary-color);">
          1
        </div>
        <h4 class="h5 fw-bold">Add Your Task</h4>
        <p class="text-muted-custom small">Enter your assignment details, subject, and estimated hours.</p>
      </div>
      
      <div class="col-md-4 text-center animate-fade-in" style="animation-delay: 0.2s;">
        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 80px; height: 80px; font-size: 2rem; color: var(--primary-color);">
          2
        </div>
        <h4 class="h5 fw-bold">Set Deadline & Priority</h4>
        <p class="text-muted-custom small">Choose when it's due and how important it is to your grade.</p>
      </div>
      
      <div class="col-md-4 text-center animate-fade-in" style="animation-delay: 0.3s;">
        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 80px; height: 80px; font-size: 2rem; color: var(--primary-color);">
          3
        </div>
        <h4 class="h5 fw-bold">Track Your Work</h4>
        <p class="text-muted-custom small">Monitor your progress and check off completed items.</p>
      </div>
    </div>
  </div>
</div>

<div class="container text-center mb-5 animate-fade-in">
  <div class="card bg-white shadow-sm border-0 p-5">
    <h2 class="fw-bold mb-3">Ready to boost your productivity?</h2>
    <p class="text-muted-custom mb-4">Start organizing your academic life today with StudyFlow.</p>
    <div>
      <a href="/tasks/new" class="btn btn-primary btn-lg px-5">Add a New Task Now</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
