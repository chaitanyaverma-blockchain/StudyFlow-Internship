<%- include('partials/header') %>

<div class="container my-5 animate-fade-in">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      
      <div class="mb-5 border-bottom pb-3">
        <h1 class="fw-bold mb-2 text-theme-heading">API Documentation</h1>
        <p class="text-theme-secondary fs-5">RESTful endpoints for the StudyFlow Task Manager</p>
        <div class="alert alert-warning border-0 shadow-sm mt-3" role="alert">
          <strong>⚠️ Temporary Storage Notice:</strong> This API currently uses in-memory storage. All data will be lost when the server restarts. Persistent database integration (MongoDB) will be implemented in Task 6.
        </div>
      </div>

      <div class="card shadow-sm border-0 mb-4 card-hover">
        <div class="card-body p-4">
          <h2 class="h4 fw-bold text-brand mb-3">Base URL</h2>
          <code class="fs-5 bg-light px-3 py-2 rounded text-dark">/api</code>
        </div>
      </div>

      <!-- Endpoint: GET /api/tasks -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-success fs-6">GET</span>
            <h3 class="h5 fw-bold mb-0 text-theme-heading">/api/tasks</h3>
          </div>
          <p class="text-theme-secondary mb-0">Retrieve all tasks.</p>
        </div>
        <div class="card-body">
          <h4 class="h6 fw-bold mt-3 mb-2">Query Parameters (Optional)</h4>
          <ul class="list-group list-group-flush mb-4 small bg-transparent">
            <li class="list-group-item bg-transparent text-theme-primary"><code class="me-2">search</code> String to filter across title, student, subject, description.</li>
            <li class="list-group-item bg-transparent text-theme-primary"><code class="me-2">priority</code> Filter by 'high', 'medium', or 'low'.</li>
            <li class="list-group-item bg-transparent text-theme-primary"><code class="me-2">status</code> Filter by 'completed' or 'pending'.</li>
            <li class="list-group-item bg-transparent text-theme-primary"><code class="me-2">sort</code> 'oldest', 'priorityDesc', 'titleAsc', 'default'.</li>
          </ul>
          
          <h4 class="h6 fw-bold mb-2">Success Response (200 OK)</h4>
          <pre class="bg-dark text-light p-3 rounded small"><code>{
  "success": true,
  "message": "Tasks retrieved successfully",
  "data": [
    {
      "id": 1,
      "studentName": "Jane Doe",
      "email": "jane@example.com",
      "taskTitle": "Math Assignment",
      "completed": false,
      ...
    }
  ]
}</code></pre>
        </div>
      </div>

      <!-- Endpoint: POST /api/tasks -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-primary fs-6">POST</span>
            <h3 class="h5 fw-bold mb-0 text-theme-heading">/api/tasks</h3>
          </div>
          <p class="text-theme-secondary mb-0">Create a new task.</p>
        </div>
        <div class="card-body">
          <h4 class="h6 fw-bold mt-3 mb-2">Required JSON Body</h4>
          <pre class="bg-dark text-light p-3 rounded small mb-4"><code>{
  "studentName": "John Doe",
  "email": "john@example.com",
  "taskTitle": "History Essay",
  "subject": "History",
  "description": "Write a 500 word essay.",
  "deadline": "2024-12-01",
  "priority": "High",
  "category": "Assignment",
  "estimatedHours": 5
}</code></pre>
          
          <h4 class="h6 fw-bold mb-2">Success Response (201 Created)</h4>
          <pre class="bg-dark text-light p-3 rounded small mb-4"><code>{
  "success": true,
  "message": "Task created successfully",
  "data": { "id": 2, ... }
}</code></pre>

          <h4 class="h6 fw-bold mb-2 text-danger">Error Response (400 Bad Request)</h4>
          <pre class="bg-dark text-light p-3 rounded small"><code>{
  "success": false,
  "message": "Validation failed",
  "errors": {
    "taskTitle": "Task title is required."
  }
}</code></pre>
        </div>
      </div>

      <!-- Endpoint: PUT /api/tasks/:id -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-warning text-dark fs-6">PUT</span>
            <h3 class="h5 fw-bold mb-0 text-theme-heading">/api/tasks/:id</h3>
          </div>
          <p class="text-theme-secondary mb-0">Update an existing task entirely.</p>
        </div>
        <div class="card-body">
          <p class="small text-theme-secondary">Expects the same JSON body and performs the same validation as POST. Returns 404 if ID is not found.</p>
        </div>
      </div>

      <!-- Endpoint: PATCH /api/tasks/:id/status -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-info text-dark fs-6">PATCH</span>
            <h3 class="h5 fw-bold mb-0 text-theme-heading">/api/tasks/:id/status</h3>
          </div>
          <p class="text-theme-secondary mb-0">Toggle or update the completion status.</p>
        </div>
        <div class="card-body">
          <h4 class="h6 fw-bold mt-3 mb-2">Required JSON Body</h4>
          <pre class="bg-dark text-light p-3 rounded small"><code>{
  "completed": true
}</code></pre>
        </div>
      </div>

      <!-- Endpoint: DELETE /api/tasks/:id -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-danger fs-6">DELETE</span>
            <h3 class="h5 fw-bold mb-0 text-theme-heading">/api/tasks/:id</h3>
          </div>
          <p class="text-theme-secondary mb-0">Delete a specific task.</p>
        </div>
        <div class="card-body">
          <h4 class="h6 fw-bold mt-3 mb-2">Success Response (200 OK)</h4>
          <pre class="bg-dark text-light p-3 rounded small"><code>{
  "success": true,
  "message": "Task deleted successfully",
  "data": {}
}</code></pre>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
