<%- include('partials/header') %>

    <section class="form-section">
      <h1>Add a New Task</h1>
      <p class="form-subtitle">Fill in the details below to add a study task.</p>

      <form action="/tasks" method="POST" class="task-form">
        <div class="form-group">
          <label for="studentName">Student Name</label>
          <input type="text" id="studentName" name="studentName" placeholder="Enter your name" required>
        </div>

        <div class="form-group">
          <label for="taskTitle">Task Title</label>
          <input type="text" id="taskTitle" name="taskTitle" placeholder="e.g. Math Homework Ch. 5" required>
        </div>

        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="e.g. Mathematics" required>
        </div>

        <div class="form-group">
          <label for="description">Task Description</label>
          <textarea id="description" name="description" rows="4" placeholder="Describe the task..." required></textarea>
        </div>

        <div class="form-group">
          <label for="deadline">Deadline</label>
          <input type="date" id="deadline" name="deadline" required>
        </div>

        <div class="form-group">
          <label for="priority">Priority</label>
          <select id="priority" name="priority" required>
            <option value="" disabled selected>Select priority</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Submit Task</button>
      </form>
    </section>

<%- include('partials/footer') %>
