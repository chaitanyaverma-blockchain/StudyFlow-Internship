<%- include('partials/header') %>

<div class="container my-5 animate-fade-in">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      
      <div class="text-center mb-4">
        <span class="display-1 text-success mb-2 d-block" aria-hidden="true">✅</span>
        <h1 class="fw-bold h2 text-success">Task Added Successfully!</h1>
        <p class="text-theme-secondary">Your task has been successfully submitted. Here are the details:</p>
      </div>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <tbody>
                <tr>
                  <th scope="row" class="w-25 border-top-0 ps-4 pt-3 text-theme-secondary">Student Name</th>
                  <td class="border-top-0 pt-3 task-detail-value"><%= task.studentName %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Email</th>
                  <td class="task-detail-value"><%= task.email %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Task Title</th>
                  <td class="fw-bold task-detail-value"><%= task.taskTitle %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Subject</th>
                  <td class="task-detail-value"><%= task.subject %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Description</th>
                  <td class="text-break task-detail-value"><%= task.description %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Deadline</th>
                  <td class="task-detail-value"><%= task.deadline %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 align-middle text-theme-secondary">Priority</th>
                  <td class="task-detail-value">
                    <% 
                      let badgeClass = 'bg-secondary';
                      if (task.priority === 'High') badgeClass = 'bg-danger';
                      if (task.priority === 'Medium') badgeClass = 'bg-warning text-dark';
                      if (task.priority === 'Low') badgeClass = 'bg-success';
                    %>
                    <span class="badge rounded-pill <%= badgeClass %>">
                      <%= task.priority %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 text-theme-secondary">Category</th>
                  <td class="task-detail-value"><%= task.category %></td>
                </tr>
                <tr>
                  <th scope="row" class="ps-4 pb-3 text-theme-secondary">Estimated Hours</th>
                  <td class="pb-3 task-detail-value"><%= task.estimatedHours %> hour<%= task.estimatedHours !== 1 ? 's' : '' %></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-4">
        <a href="/tasks/new" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Add Another Task</a>
        <a href="/tasks" class="btn btn-outline-primary px-4 py-2 shadow-sm">View All Tasks</a>
        <a href="/" class="btn btn-outline-secondary px-4 py-2 shadow-sm">Return Home</a>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
